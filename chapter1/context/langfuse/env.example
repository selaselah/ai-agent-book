# Copy to .env (Git-ignored), replace placeholders, and keep chmod 600.
# Generate NEXTAUTH_SECRET/SALT with openssl rand -hex 32.
# ENCRYPTION_KEY must be exactly 64 random hexadecimal characters.
NEXTAUTH_URL=https://ai-tutor-helper.corp.youdao.com/langfuse/api/auth
NEXT_PUBLIC_BASE_PATH=/langfuse
LANGFUSE_WEB_IMAGE=context-lab/langfuse-web:4.66.0-reasoning-subpath
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
SALT=REPLACE_WITH_RANDOM_SALT
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/postgres
CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD
REDIS_AUTH=REPLACE_WITH_REDIS_PASSWORD
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=REPLACE_WITH_STORAGE_PASSWORD
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_PASSWORD
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://miniboard-dev1.ycs.ynode.cn:9060
LANGFUSE_INIT_ORG_ID=context-lab
LANGFUSE_INIT_ORG_NAME=Context Lab
LANGFUSE_INIT_PROJECT_ID=ai-agent-book-experiments
LANGFUSE_INIT_PROJECT_NAME=AI Agent Book Experiments
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=REPLACE_WITH_PROJECT_PUBLIC_KEY
LANGFUSE_INIT_PROJECT_SECRET_KEY=REPLACE_WITH_PROJECT_SECRET_KEY
LANGFUSE_INIT_USER_EMAIL=user@example.com
LANGFUSE_INIT_USER_NAME=Context Lab Owner
LANGFUSE_INIT_USER_PASSWORD=REPLACE_WITH_LOGIN_PASSWORD
TELEMETRY_ENABLED=false
POSTGRES_VERSION=17
